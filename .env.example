# Local environment template for docker-compose.yml and the Spring Boot application.
#
# Copy this file before the first start:
#   cp .env.example .env
#
# Every value below is a local placeholder. Never put real credentials,
# production connection strings, or patient data (PHI) in this file.

# --- Spring Boot application (healthcare-application) ---
# Port the application itself listens on; 8081 avoids the HAPI FHIR server on 8080.
APP_PORT=8081

# --- Application PostgreSQL (app-postgres) ---
# Operational metadata only: message processing state and resource mappings.
# Published on the host so the Spring Boot application can reach it.
APP_DB_HOST=localhost
APP_DB_PORT=5432
APP_DB_NAME=healthcare
APP_DB_USER=healthcare
APP_DB_PASSWORD=change-me-app-password

# --- HAPI FHIR R4 JPA server (hapi-fhir) ---
# Tag verified against https://hub.docker.com/r/hapiproject/hapi on 2026-10-08.
# The -tomcat variant is pinned deliberately: the default hapiproject/hapi image
# is distroless (no shell, no curl) and cannot run the /fhir/metadata health check.
HAPI_FHIR_IMAGE_TAG=v8.12.0-2-tomcat
HAPI_FHIR_PORT=8080

# --- FHIR PostgreSQL (fhir-postgres) ---
# Clinical resource storage owned by the HAPI FHIR server. Internal to the
# compose network only; no host port, and the Spring Boot application never
# connects to it directly.
FHIR_DB_NAME=hapi
FHIR_DB_USER=hapi
FHIR_DB_PASSWORD=change-me-fhir-password
